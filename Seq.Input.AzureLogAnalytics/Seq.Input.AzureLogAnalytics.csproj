<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <VersionPrefix>1.1.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Description>Seq custom input that polls an Azure Log Analytics workspace and publishes events to Seq.</Description>
    <PackageProjectUrl>https://github.com/ultrabstrong/SeqInputApps</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ultrabstrong/SeqInputApps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>ultrabstrong</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>seq;seq-app;seq-input;azure-log-analytics;application-insights;azure-monitor;kql;clef;observability</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Seq.Apps" Version="2023.4.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Monitor.Query" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="./obj/publish/**/*" Exclude="./obj/publish/Seq.Input.AzureLogAnalytics.dll;./obj/publish/Seq.Input.AzureLogAnalytics.pdb;./obj/publish/Seq.Apps.dll;./obj/publish/Serilog.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
