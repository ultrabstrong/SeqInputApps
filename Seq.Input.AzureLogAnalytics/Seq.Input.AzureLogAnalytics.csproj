<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.17</Version>
    <VersionPrefix>1.0.17</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Description>Seq custom input that polls an Azure Log Analytics workspace and publishes events to Seq.</Description>
    <Authors>Pinnacle Innovation</Authors>
    <PackageTags>seq-app</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Seq.Apps" Version="2023.4.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Monitor.Query" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="./obj/publish/**/*" Exclude="./obj/publish/Seq.Input.AzureLogAnalytics.dll;./obj/publish/Seq.Apps.dll;./obj/publish/Serilog.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
  </ItemGroup>

</Project>
